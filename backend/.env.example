MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_URL>/crowdfunding_db
DATABASE_NAME=crowdfunding_db

# Khoa bao mat de ky JWT (doi thanh chuoi ngau nhien dai khi trien khai)
SECRET_KEY=<KHOA_JWT_BAO_MAT>
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gui email Gmail SMTP (App Password 16 ky tu)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<EMAIL_GUI@gmail.com>
SMTP_PASSWORD=<APP_PASSWORD_16_KY_TU>

# Google Gemini AI (mien phi tai https://aistudio.google.com/apikey)
GEMINI_API_KEY=<KEY_TU_AI_STUDIO>
GEMINI_MODEL=gemini-3.5-flash-lite
